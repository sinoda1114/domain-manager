# アプリケーション
ROOT_DOMAIN=shinodev.com
NEXT_PUBLIC_SITE_URL=https://domains.shinodev.com
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Turso / libSQL（サーバー側でのみ使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare（サーバー側でのみ使用。トークンはshinodev.comと対象アカウントへ限定）
# Zone ID: https://dash.cloudflare.com/ で shinodev.com を開き、Overviewから取得
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Vercel（サーバー側でのみ使用。トークン作成: https://vercel.com/account/tokens ）
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Gemini（サブドメイン候補の生成にのみ使用。ブラウザへは公開しない）
GEMINI_API_KEY=

# GitHub（任意。非公開リポジトリのREADME等を読む場合のみ。repo読み取り権限に限定）
GITHUB_TOKEN=

# Vercel Cron（本番の定期状態確認に使用）
CRON_SECRET=
