# アプリケーション
ROOT_DOMAIN=shinodev.com
NEXT_PUBLIC_SITE_URL=https://domains.shinodev.com
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Turso / libSQL（サーバー側でのみ使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare（サーバー側でのみ使用。トークンはshinodev.comと対象アカウントへ限定）
# Zone ID: https://dash.cloudflare.com/ で shinodev.com を開き、Overviewから取得
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Vercel（サーバー側でのみ使用。トークン作成: https://vercel.com/account/tokens ）
VERCEL_TOKEN=
VERCEL_TEAM_ID=
